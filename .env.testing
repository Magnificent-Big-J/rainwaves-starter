# Used only by the Playwright E2E suite's self-contained server (scripts/e2e-server.sh).
# Laravel auto-loads this instead of .env whenever APP_ENV=testing is exported as a real
# OS env var before boot. Not used by PHPUnit — that suite injects its own env vars
# directly via phpunit.xml and runs entirely in-memory, no real HTTP server involved.
#
# The APP_KEY below is a fixed, throwaway value for this ephemeral, always-rebuilt
# sqlite database — never used for anything real. Safe to commit.
APP_NAME="Rainwaves Starter"
APP_ENV=testing
APP_KEY=base64:4KhqFwkTazlgkyqAIHPxOR566ADXDkwHdx7AeiHLANY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8080

APP_BRAND_NAME="Rainwaves Starter"
APP_BRAND_SHORT_NAME=RW
APP_BRAND_TAGLINE="Production-ready Laravel + Vue starter"
APP_SUPPORT_EMAIL=support@example.com
APP_TERMS_URL=/legal/terms
APP_PRIVACY_URL=/legal/privacy
APP_BRAND_FOOTER="Rainwaves Starter — Laravel 13"

SHOW_SHOWCASE_PAGES=true

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=4

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=database/e2e.sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SANCTUM_STATEFUL_DOMAINS=127.0.0.1:8080,localhost:8080

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MEDIA_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

MAIL_MAILER=array
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AUTHX_FRONTEND_RESET_URL=/auth/reset-password
AUTHX_2FA_ENFORCEMENT=optional

PAYFAST_MERCHANT_ID=10004002
PAYFAST_MERCHANT_KEY=q1cd2rdny4a53
PAYFAST_ENV=sandbox
PAYFAST_RETURN_URL="${APP_URL}/payments/payfast/return"
PAYFAST_CANCEL_URL="${APP_URL}/payments/payfast/cancel"
PAYFAST_NOTIFY_URL="${APP_URL}/payments/payfast/itn"
PAYFAST_PASS_PHRASE=payfast

HORIZON_ALLOWED_EMAILS=

VITE_APP_NAME="${APP_NAME}"
VITE_GOOGLE_MAPS_API_KEY=
